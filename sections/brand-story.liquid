<section class="el-story"><div class="story-visual">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.heading | escape }}{% else %}<div class="story-art"><div class="story-ring"></div><div class="story-object"></div></div>{% endif %}<span>ELVORA / SINCE 2026</span></div><div class="story-copy"><div class="el-section-top"><span>{{ section.settings.kicker | escape }}</span><span>05 / OUR APPROACH</span></div><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p>{% if section.settings.link_text != blank %}<a class="text-link" href="{{ section.settings.link_url | default: routes.root_url }}">{{ section.settings.link_text | escape }} ↗</a>{% endif %}</div></section>
{% schema %}{"name":"Brand story","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"THE ELVORA APPROACH"},{"type":"text","id":"heading","label":"Heading","default":"YOUR SPACE SHOULD WORK FOR YOU."},{"type":"textarea","id":"text","label":"Text","default":"ELVORA creates thoughtful everyday products designed to bring order, simplicity and beauty into the spaces you live in. We believe good organization should feel effortless — not clinical, not complicated, just considered."},{"type":"image_picker","id":"image","label":"Story image"},{"type":"text","id":"link_text","label":"Link text","default":"DISCOVER OUR STORY"},{"type":"url","id":"link_url","label":"Link URL"}],"presets":[{"name":"Brand story"}]}{% endschema %}