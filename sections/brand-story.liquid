<section class="story page-width">
  <div class="story-number">{{ section.settings.number | escape }}</div>
  <div>
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
    {% if section.settings.body != blank %}<p>{{ section.settings.body }}</p>{% endif %}
    {% if section.settings.link_text != blank %}<a class="text-link" href="{{ section.settings.link | default: routes.root_url }}">{{ section.settings.link_text | escape }} ↗</a>{% endif %}
  </div>
</section>
{% schema %}
{"name":"Brand story","settings":[{"type":"text","id":"number","label":"Section number","default":"03"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE ELVORA APPROACH"},{"type":"textarea","id":"heading","label":"Heading","default":"YOUR SPACE\nSHOULD WORK\nFOR YOU."},{"type":"textarea","id":"body","label":"Body","default":"ELVORA creates thoughtful everyday products designed to bring order, simplicity and beauty into the spaces you live in."},{"type":"text","id":"link_text","label":"Link text","default":"DISCOVER OUR STORY"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Brand story"}]}
{% endschema %}