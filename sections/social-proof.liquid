<section class="el-social"><div class="el-wrap"><div class="el-section-top"><span>{{ section.settings.kicker | escape }}</span><span>04 / REAL SPACES</span></div><div class="social-head"><h2>{{ section.settings.heading | escape }}</h2><a href="{{ settings.instagram_url | default: '#' }}" target="_blank" rel="noopener">{{ settings.instagram_handle | escape }} ↗</a></div><div class="social-grid">{% for block in section.blocks %}<a class="social-tile social-tile-{{ forloop.index }}" href="{{ settings.instagram_url | default: '#' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.alt | escape }}{% else %}<div class="social-art"><span>{{ block.settings.word | escape }}</span><small>ELVORA / LIVING</small></div>{% endif %}<div class="social-hover">VIEW POST ↗</div></a>{% endfor %}</div></div></section>
{% schema %}{"name":"Social proof","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"SEEN IN REAL SPACES"},{"type":"text","id":"heading","label":"Heading","default":"A CALMER WAY TO LIVE."}],"blocks":[{"type":"tile","name":"Social tile","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"word","label":"Fallback word","default":"ORDER"},{"type":"text","id":"alt","label":"Alt text","default":"ELVORA organized living space"}]}],"presets":[{"name":"Social proof","blocks":[{"type":"tile"},{"type":"tile","settings":{"word":"FOCUS"}},{"type":"tile","settings":{"word":"QUIET"}},{"type":"tile","settings":{"word":"ROOM"}},{"type":"tile","settings":{"word":"EVERYDAY"}}]}]}
{% endschema %}