<section class="products page-width"><div class="section-head"><p class="eyebrow">THE EDIT / 02</p><h2>{{ section.settings.heading }}</h2><a href="{{ routes.all_products_collection_url }}">VIEW ALL ↗</a></div><div class="product-grid">{% for product in collections.all.products limit: section.settings.products_to_show %}<article class="product-card"><a href="{{ product.url }}"><div class="product-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% endif %}</div><div class="product-meta"><h3>{{ product.title }}</h3><p>{{ product.price | money }}</p></div></a><form method="post" action="{{ routes.cart_add_url }}" class="quick-add"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button type="submit">QUICK ADD +</button></form></article>{% else %}<p>Add products in Shopify admin to populate this collection.</p>{% endfor %}</div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"heading","label":"Heading","default":"CURATED FOR EVERYDAY LIFE"},{"type":"range","id":"products_to_show","label":"Products","min":2,"max":8,"step":1,"default":4}]}{% endschema %}