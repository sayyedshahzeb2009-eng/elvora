<section class="product-detail page-width">
  <div class="product-detail-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', alt: product.featured_image.alt | default: product.title }}{% endif %}</div>
  <div class="product-detail-copy">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ product.title }}</h1>
    <div class="product-price">{{ product.selected_or_first_available_variant.price | money }}</div>
    {% if section.settings.show_description %}<div class="product-description">{{ product.description }}</div>{% endif %}
    {% form 'product', product %}
      {% if product.has_only_default_variant == false %}<select name="id" aria-label="Variant">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}
      <button class="button product-add" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ section.settings.add_to_cart_text | escape }} ↗{% else %}{{ section.settings.sold_out_text | escape }}{% endif %}</button>
    {% endform %}
  </div>
</section>
{% schema %}
{"name":"Main product","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ELVORA / ESSENTIAL"},{"type":"checkbox","id":"show_description","label":"Show description","default":true},{"type":"text","id":"add_to_cart_text","label":"Add to cart text","default":"ADD TO CART"},{"type":"text","id":"sold_out_text","label":"Sold out text","default":"SOLD OUT"}],"presets":[{"name":"Main product"}]}
{% endschema %}