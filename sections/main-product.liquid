<section class="product-detail page-width"><div class="product-detail-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: product.featured_image.alt | default: product.title }}{% endif %}</div><div class="product-detail-copy"><p class="eyebrow">ELVORA / ESSENTIAL</p><h1>{{ product.title }}</h1><div class="product-price">{{ product.price | money }}</div><div class="product-description">{{ product.description }}</div>{% form 'product', product %}<select name="id" aria-label="Variant">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select><button class="button product-add" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}ADD TO CART ↗{% else %}SOLD OUT{% endif %}</button>{% endform %}</div></section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}