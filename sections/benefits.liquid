<section class="el-benefits"><div class="el-wrap"><div class="el-section-top"><span>{{ section.settings.kicker | escape }}</span><span>03 / WHY ELVORA</span></div><div class="benefit-intro"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div><div class="benefit-list">{% for block in section.blocks %}<div class="benefit-row" {{ block.shopify_attributes }}><span class="benefit-index">0{{ forloop.index }}</span><div class="benefit-icon">{{ block.settings.icon }}</div><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div><span class="benefit-mark">↗</span></div>{% endfor %}</div></div></section>
{% schema %}{"name":"Benefits","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"THE ELVORA STANDARD"},{"type":"text","id":"heading","label":"Heading","default":"GOOD DESIGN SHOULD DISAPPEAR INTO YOUR LIFE."},{"type":"textarea","id":"description","label":"Description","default":"Quietly useful objects, made to earn their place."}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"icon","label":"Icon character","default":"○"},{"type":"text","id":"title","label":"Title","default":"SPACE-SAVING"},{"type":"textarea","id":"text","label":"Text","default":"Thoughtful proportions that make more room without adding visual noise."}]}],"presets":[{"name":"Benefits","blocks":[{"type":"benefit","settings":{"icon":"◌","title":"SPACE-SAVING"}},{"type":"benefit","settings":{"icon":"◇","title":"THOUGHTFULLY DESIGNED"}},{"type":"benefit","settings":{"icon":"⌁","title":"BUILT FOR EVERYDAY LIFE"}},{"type":"benefit","settings":{"icon":"○","title":"MINIMAL BY DESIGN"}}]}]}
{% endschema %}