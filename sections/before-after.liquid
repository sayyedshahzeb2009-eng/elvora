<section class="el-compare" data-compare><div class="el-wrap"><div class="el-section-top"><span>{{ section.settings.kicker | escape }}</span><span>02 / TRANSFORM</span></div><div class="el-compare-head"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div><div class="compare-frame" tabindex="0" aria-label="Before and after comparison. Use arrow keys to move slider">
  <div class="compare-layer compare-after">{% if section.settings.after_image != blank %}{{ section.settings.after_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.after_label | escape }}{% else %}<div class="compare-art after-art"><div class="fake-shelf"></div><div class="fake-box one"></div><div class="fake-box two"></div><div class="fake-box three"></div></div>{% endif %}<span class="compare-label after-label">{{ section.settings.after_label | escape }}</span></div>
  <div class="compare-layer compare-before" data-before>{% if section.settings.before_image != blank %}{{ section.settings.before_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.before_label | escape }}{% else %}<div class="compare-art before-art"><div class="mess m1"></div><div class="mess m2"></div><div class="mess m3"></div><div class="mess m4"></div><div class="mess m5"></div></div>{% endif %}<span class="compare-label before-label">{{ section.settings.before_label | escape }}</span></div>
  <div class="compare-handle" data-handle><span>↔</span></div><input class="compare-range" data-range type="range" min="0" max="100" value="48" aria-label="Before and after position">
</div></div></section>
{% schema %}{"name":"Before / after","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"THE ELVORA EFFECT"},{"type":"text","id":"heading","label":"Heading","default":"FROM CLUTTERED TO CONSIDERED."},{"type":"textarea","id":"description","label":"Description","default":"A little intention can change the feeling of an entire room."},{"type":"image_picker","id":"before_image","label":"Before image"},{"type":"image_picker","id":"after_image","label":"After image"},{"type":"text","id":"before_label","label":"Before label","default":"BEFORE"},{"type":"text","id":"after_label","label":"After label","default":"ELVORA"}],"presets":[{"name":"Before / after"}]}{% endschema %}