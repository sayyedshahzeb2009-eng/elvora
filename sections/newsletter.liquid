<section class="el-newsletter"><div class="el-newsletter-inner"><div><span class="eyebrow">{{ section.settings.kicker | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div><div><p>{{ section.settings.description | escape }}</p>{% form 'customer', class: 'el-newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="ElvoraNewsletterEmail">{{ section.settings.email_label | escape }}</label><input id="ElvoraNewsletterEmail" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | escape }}" required autocomplete="email"><button type="submit">{{ section.settings.button_text | escape }} ↗</button>{% endform %}</div></div></section>
{% schema %}{"name":"Newsletter","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"A NOTE FROM ELVORA"},{"type":"text","id":"heading","label":"Heading","default":"MAKE ROOM FOR BETTER LIVING."},{"type":"textarea","id":"description","label":"Description","default":"New objects, small-space ideas and thoughtful ways to make everyday life feel lighter — delivered occasionally, never noisily."},{"type":"text","id":"email_label","label":"Email label","default":"Email address"},{"type":"text","id":"placeholder","label":"Placeholder","default":"your@email.com"},{"type":"text","id":"button_text","label":"Button text","default":"JOIN ELVORA"}],"presets":[{"name":"ELVORA Newsletter"}]}{% endschema %}